# Drizzle / PostgreSQL
# Replace with your DB credentials. In Dokploy, copy the database's
# "Internal Connection URL" here when app and database share a project/environment.
DATABASE_URL="postgres://user:password@host:port/db-name"

# Public URL of the app, e.g. https://portal.example.com
ORIGIN=""

# Adapter Node behind a reverse proxy (Dokploy/Traefik). Optional locally.
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"

# Better Auth
# For production use 32+ characters generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public self-registration after the first owner exists (true/false).
# The very first user can always register to bootstrap the workspace.
ALLOW_REGISTRATION="false"

# Document storage: local | r2
STORAGE_DRIVER="local"

# Used when STORAGE_DRIVER=local
UPLOAD_DIR="uploads"

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=""
# Optional explicit endpoint; derived from R2_ACCOUNT_ID when empty
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Optional: true for MinIO/path-style S3-compatible endpoints
R2_FORCE_PATH_STYLE="false"

# Migration retry on container start (optional)
# MIGRATION_RETRIES=10
# MIGRATION_RETRY_DELAY_MS=3000

# Total document storage quota (8 GiB)
STORAGE_QUOTA_BYTES="8589934592"
